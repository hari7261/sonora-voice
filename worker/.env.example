# Never commit actual secrets.
PORT=8080
SHERPA_WORKER_SECRET=replace-with-a-random-32-plus-character-secret
# Replace the examples with valid Sherpa-ONNX model configuration pointing to the mounted model weights.
# Consult https://k2-fsa.github.io/sherpa/onnx/javascript-api/index.html
SHERPA_ASR_CONFIG_JSON={"modelConfig":{"transducer":{"encoder":"/models/asr/encoder.onnx","decoder":"/models/asr/decoder.onnx","joiner":"/models/asr/joiner.onnx"},"tokens":"/models/asr/tokens.txt","numThreads":2,"provider":"cpu"}}
SHERPA_TTS_CONFIG_JSON={"model":{"vits":{"model":"/models/tts/model.onnx","tokens":"/models/tts/tokens.txt","dataDir":"/models/tts/espeak-ng-data"}},"numThreads":2,"provider":"cpu"}
SHERPA_VOICES_JSON={"default":0}
