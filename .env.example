# Vāchaspati AI / NEXT.JS SERVER CONFIG
# PostgreSQL transaction pooler connection string from Supabase > Connect.
# Use a dedicated database role with access ONLY to vachaspati_private for production.
# NEVER use NEXT_PUBLIC_ for these secrets.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres
APP_ORIGIN=https://your-production-domain.example

# Real LLM conversations (private, server only).
OPENROUTER_API_KEY=put-real-openrouter-secret-here
# Optional fallback for newly created agents. Each agent can override this in PostgreSQL.
OPENROUTER_DEFAULT_MODEL=provider/model-name

# Separate Sherpa-ONNX inference worker hosted on CPU/GPU VM or container.
SHERPA_INFERENCE_URL=https://your-private-inference-host.example
SHERPA_WORKER_SECRET=replace-with-the-same-random-32-plus-character-secret-as-worker

# Optional live demo agent, only when created and published to the site's own domain.
# Public agent IDs are not passwords.
NEXT_PUBLIC_VACHASPATI_DEMO_AGENT_ID=
# Never enable plaintext connections in production.
# DATABASE_SSL_MODE=disable

# Optional but required for password reset email delivery and secure account recovery.
# Verify MAIL_FROM domain with the provider before production.
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=Vachaspati AI <security@your-verified-domain.example>
