# Server-only Supabase PostgreSQL transaction-pooler URL (Supabase dashboard > Connect).
# Never prefix this variable with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres
# Set to your deployed website origin, for same-origin form protection.
APP_ORIGIN=https://your-vachaspati-domain.example
# For local PostgreSQL without TLS only. NEVER use this in production.
# DATABASE_SSL_MODE=disable
